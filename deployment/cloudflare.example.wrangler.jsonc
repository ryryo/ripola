// Public samples only. Copy to cloudflare.wrangler.jsonc and choose your own unique Worker name.
// Add your deployment account_id only to the local copy if multiple accounts exist.
{
  "name": "ripola-your-demo",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "main": "../scripts/public-audio-worker.mjs",
  "assets": {
    "directory": "../dist/distribution/worker",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/library/books/*", "/samples/audio/library/books/*", "/_serverFn/*", "/api/local-*", "/generate", "/generate/*"]
  }
}
