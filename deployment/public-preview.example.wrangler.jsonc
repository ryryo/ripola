// Generic public preview example. Keep an actual deployment name in an ignored *.local.wrangler.jsonc copy.
{
  "name": "ripola-your-public-preview",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist/distribution/worker",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/library/books/*",
      "/samples/audio/library/books/*",
      "/_serverFn/*",
      "/api/local-*",
      "/generate",
      "/generate/*"
    ]
  },
  "main": "../scripts/public-audio-worker.mjs",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
